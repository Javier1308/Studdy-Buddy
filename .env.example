# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Provider — allowed: mock | nvidia-nim | openai | anthropic
AI_PROVIDER=mock

# NVIDIA NIM (required when AI_PROVIDER=nvidia-nim)
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# OpenAI (required when AI_PROVIDER=openai — not yet implemented)
OPENAI_API_KEY=sk-...

# Anthropic (required when AI_PROVIDER=anthropic — not yet implemented)
ANTHROPIC_API_KEY=sk-ant-...
