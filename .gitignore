# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Supabase local
supabase/.branches/
supabase/.temp/

# Temporary/test files
prueba*.txt
material_*.txt

# Local development
.env.local
.env.*.local
*.local

# Build artifacts
dist/
build/

# Lock files (optional - uncomment if you want to ignore these)
# package-lock.json
# pnpm-lock.yaml

# OS files
Thumbs.db
.AppleDouble
.LSOverride

# IDE metadata
.vscode/settings.json
.idea/workspace.xml
